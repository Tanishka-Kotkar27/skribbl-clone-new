# Copy to .env.local for local development. Set the same names as environment
# variables in Vercel/Netlify for production.
#
# In production these MUST be https:// and wss:// respectively. An HTTPS page is
# not allowed to open an insecure ws:// socket, and that failure only appears
# once deployed — it is the single most common production-only bug in this kind
# of project.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
